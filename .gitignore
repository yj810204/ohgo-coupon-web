# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local AI briefing file store
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Expo mobile (mobile/.gitignore mirrors most rules)
mobile/node_modules/
mobile/.expo/

# OCR 언어 데이터 (tesseract.js)
*.traineddata
.cache/

# 승선기록 원장 스크립트 보고서
/reports/

# Band 게시글 가져오기 도구: 로그인 프로필(쿠키), 추출 결과
/tools/band-import/user-data/
/tools/band-import/out/
/tools/band-import/.env*
