{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://ohgo.codejaka.com",
        "EXPO_PUBLIC_USE_HOSTED": "true"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://ohgo.codejaka.com",
        "EXPO_PUBLIC_USE_HOSTED": "true"
      }
    },
    "production-local": {
      "extends": "production",
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {}
    }
  }
}
